{
    "version": "0.41.0.922-gf4d13e1c2",
    "description": "mpv is a free media player for the command line that supports a wide variety of media file formats, audio and video codecs, and subtitle types (Nightly)",
    "homepage": "https://mpv.io",
    "license": "GPL-2.0-or-later OR LGPL-2.1-or-later",
    "notes": "To register file associations, run mpv --register",
    "suggest": {
        "yt-dlp": [
            "main/yt-dlp",
            "kazzarin/yt-dlp-nightly"
        ]
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/mpv-player/mpv/releases/download/git-release/mpv-v0.41.0-dev-gf4d13e1c2-31356187173-x86_64-pc-windows-msvc.zip",
            "hash": "ecbac93878aaba79cab62105e5186f93701deeacb14b95a3afa70d0369cb1ba9"
        },
        "arm64": {
            "url": "https://github.com/mpv-player/mpv/releases/download/git-release/mpv-v0.41.0-dev-gf4d13e1c2-31356187173-aarch64-pc-windows-msvc.zip",
            "hash": "a4e3835603ae423ed87d50ee3138efd780aac52ccd11590809584505ba2baffd"
        }
    },
    "env_add_path": ".",
    "shortcuts": [
        [
            "mpv.exe",
            "mpv"
        ]
    ],
    "persist": "portable_config",
    "checkver": {
        "github": "https://api.github.com/repos/mpv-player/mpv/releases",
        "jsonpath": "$[?(@.tag_name == 'git-release')].body",
        "regex": "(?s)Version: `v([\\d.]+)-(\\d+)-(g[\\da-f]+)`.*?-(?<runid>\\d+)-x86_64",
        "replace": "${1}.${2}-${3}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mpv-player/mpv/releases/download/git-release/mpv-v$majorVersion.$minorVersion.$patchVersion-dev-$preReleaseVersion-$matchRunid-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/mpv-player/mpv/releases/download/git-release/mpv-v$majorVersion.$minorVersion.$patchVersion-dev-$preReleaseVersion-$matchRunid-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
