        [
            "mpv.exe",
            "mpv"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/mpv-player/mpv/releases",
        "jsonpath": "$[?(@.tag_name == 'git-release')].body",
        "regex": "(?s)Version: `v([\\d.]+)-(\\d+)-(g[\\da-f]+)`.*?-(?<runid>\\d+)-x86_64",
        "replace": "${1}.${2}-${3}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mpv-player/mpv/releases/download/git-release/mpv-v$majorVersion.$minorVersion.$patchVersion-dev-$preReleaseVersion-$matchRunid-x86_64-pc-windows-msvc.zip"
            },
            "arm64": {
                "url": "https://github.com/mpv-player/mpv/releases/download/git-release/mpv-v$majorVersion.$minorVersion.$patchVersion-dev-$preReleaseVersion-$matchRunid-aarch64-pc-windows-msvc.zip"
            }
        }
    }
}
