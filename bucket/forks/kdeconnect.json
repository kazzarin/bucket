{
    "version": "26.08-6765",
    "description": "Communications and data transfer between devices over local networks",
    "homepage": "https://kdeconnect.kde.org",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-26.08/windows/kdeconnect-kde-release_26.08-6765-windows-cl-msvc2022-x86_64.7z",
            "hash": "d04a7897022626d332c0fa2edd3e81cbac674edd11878419a74514e76f41be5a"
        }
    },
    "bin": "bin\\kdeconnect-cli.exe",
    "shortcuts": [
        [
            "bin\\kdeconnect-indicator.exe",
            "KDE Connect"
        ]
    ],
    "checkver": {
        "script": [
            "$relRes = $(Invoke-WebRequest 'https://cdn.kde.org/ci-builds/network/kdeconnect-kde/?C=M;O=D').Content",
            "$relRes -match 'release-([\\d.]+)'",
            "$major = $Matches.1",
            "$verRes = $(Invoke-WebRequest \"https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-$major/windows/\").Content",
            "$verRes -match \"kdeconnect-kde-release_$major-(\\d+)\"",
            "$build = $Matches.1",
            "\"$major-$build\""
        ],
        "regex": "([\\d.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-$majorVersion.$minorVersion/windows/kdeconnect-kde-release_$version-windows-cl-msvc2022-x86_64.7z"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
