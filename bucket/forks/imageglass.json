            "hash": "b0b62dade6238c719c13cfb55a05b4cfaddecff9e4c20af09f923eac2b3344af",
            "extract_dir": "ImageGlass_x64"
        },
        "arm64": {
            "url": "https://github.com/d2phap/ImageGlass/releases/download/9.6.1.807/ImageGlass_9.6.1.807_arm64.zip",
            "hash": "9d8c1aecd79f15e4f11634bf7f9e5889b805d2e8c8fcd949803e6603788bc520",
            "extract_dir": "ImageGlass_arm64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\igconfig.json\")) {",
        "    Add-Content \"$dir\\igconfig.json\" '{\"_Metadata\":{\"Description\":\"ImageGlass configuration file\",\"Version\":\"9.0\"},\"AutoUpdate\":\"0\"}' -Encoding utf8",
        "}"
    ],
    "bin": [
        "ImageGlass.exe",
        "igcmd.exe"
    ],
    "shortcuts": [
        [
            "ImageGlass.exe",
            "ImageGlass"
        ]
    ],
    "persist": [
        "Themes",
        "igconfig.json"
    ],
    "checkver": {
        "github": "https://github.com/d2phap/ImageGlass"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/d2phap/ImageGlass/releases/download/$version/ImageGlass_$version_x64.zip",
                "extract_dir": "ImageGlass_x64"
            },
            "arm64": {
                "url": "https://github.com/d2phap/ImageGlass/releases/download/$version/ImageGlass_$version_arm64.zip",
                "extract_dir": "ImageGlass_arm64"
            }
        }
    }
